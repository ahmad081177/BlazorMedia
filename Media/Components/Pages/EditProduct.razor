@page "/products/edit/{id:int}"
@rendermode InteractiveServer

@using MediaModels
@using Media.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ProductsService ProductService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment

<PageTitle>Edit Product</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            @if (isLoading)
            {
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3">Loading product...</p>
                </div>
            }
            else if (product == null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> Product not found!
                </div>
            }
            else
            {
                <div class="card shadow-lg">
                    <div class="card-header bg-warning text-dark">
                        <h3 class="mb-0">
                            <i class="bi bi-pencil-square"></i> Edit Product
                        </h3>
                    </div>
                    <div class="card-body p-4">
                        <EditForm Model="@product" OnValidSubmit="@HandleValidSubmit">
                            <DataAnnotationsValidator />

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
                                    <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="bi bi-check-circle-fill"></i> @successMessage
                                    <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
                                </div>
                            }

                            <!-- Product ID (Read-only) -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-hash"></i> Product ID
                                </label>
                                <input type="text" class="form-control" value="@product.ID" disabled />
                            </div>

                            <!-- Product Name -->
                            <div class="mb-3">
                                <label for="productName" class="form-label fw-bold">
                                    <i class="bi bi-tag"></i> Product Name <span class="text-danger">*</span>
                                </label>
                                <InputText id="productName"
                                           class="form-control form-control-lg"
                                           @bind-Value="product.Name"
                                           placeholder="Enter product name" />
                                <ValidationMessage For="@(() => product.Name)" class="text-danger" />
                            </div>

                            <!-- Product Info -->
                            <div class="mb-3">
                                <label for="productInfo" class="form-label fw-bold">
                                    <i class="bi bi-info-circle"></i> Product Information
                                </label>
                                <InputTextArea id="productInfo"
                                               class="form-control"
                                               rows="4"
                                               @bind-Value="product.Info"
                                               placeholder="Enter product description and details" />
                                <ValidationMessage For="@(() => product.Info)" class="text-danger" />
                            </div>

                            <!-- Primary Image -->
                            <div class="mb-3">
                                <label for="image1" class="form-label fw-bold">
                                    <i class="bi bi-image"></i> Primary Image <span class="text-danger">*</span>
                                </label>

                                @if (!string.IsNullOrEmpty(product.Image1))
                                {
                                    <div class="mb-2">
                                        <img src="/@product.Image1" alt="Current Image 1" class="img-thumbnail" style="max-height: 150px;" />
                                        <div class="mt-1">
                                            <small class="text-muted">Current: @product.Image1</small>
                                        </div>
                                    </div>
                                }

                                <div class="input-group">
                                    <InputFile id="image1Input"
                                               class="form-control"
                                               OnChange="@(e => HandleFileSelected(e, 1))"
                                               accept="image/*" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="@(() => ClearFile(1))">
                                        <i class="bi bi-x-circle"></i> Clear
                                    </button>
                                </div>

                                @if (!string.IsNullOrEmpty(image1Preview))
                                {
                                    <div class="mt-2">
                                        <strong>New Image Preview:</strong>
                                        <img src="@image1Preview" alt="Preview" class="img-thumbnail d-block mt-1" style="max-height: 150px;" />
                                    </div>
                                }
                                <ValidationMessage For="@(() => product.Image1)" class="text-danger" />
                            </div>

                            <!-- Secondary Image -->
                            <div class="mb-3">
                                <label for="image2" class="form-label fw-bold">
                                    <i class="bi bi-image"></i> Secondary Image (Optional)
                                </label>

                                @if (!string.IsNullOrEmpty(product.Image2))
                                {
                                    <div class="mb-2">
                                        <img src="/@product.Image2" alt="Current Image 2" class="img-thumbnail" style="max-height: 150px;" />
                                        <div class="mt-1">
                                            <small class="text-muted">Current: @product.Image2</small>
                                        </div>
                                    </div>
                                }

                                <div class="input-group">
                                    <InputFile id="image2Input"
                                               class="form-control"
                                               OnChange="@(e => HandleFileSelected(e, 2))"
                                               accept="image/*" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="@(() => ClearFile(2))">
                                        <i class="bi bi-x-circle"></i> Clear
                                    </button>
                                </div>

                                @if (!string.IsNullOrEmpty(image2Preview))
                                {
                                    <div class="mt-2">
                                        <strong>New Image Preview:</strong>
                                        <img src="@image2Preview" alt="Preview" class="img-thumbnail d-block mt-1" style="max-height: 150px;" />
                                    </div>
                                }
                            </div>

                            <!-- Video -->
                            <div class="mb-4">
                                <label for="video" class="form-label fw-bold">
                                    <i class="bi bi-camera-video"></i> Product Video (Optional)
                                </label>

                                @if (!string.IsNullOrEmpty(product.Video))
                                {
                                    <div class="mb-2">
                                        <small class="text-muted">Current: @product.Video</small>
                                    </div>
                                }

                                <div class="input-group">
                                    <InputFile id="videoInput"
                                               class="form-control"
                                               OnChange="@HandleVideoSelected"
                                               accept="video/*" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="@(() => ClearFile(3))">
                                        <i class="bi bi-x-circle"></i> Clear
                                    </button>
                                </div>
                                <small class="form-text text-muted">Supported formats: MP4, AVI, MOV, etc.</small>
                            </div>

                            <!-- Upload Progress -->
                            @if (isUploading)
                            {
                                <div class="mb-3">
                                    <div class="progress">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                                             role="progressbar"
                                             style="width: 100%">
                                            Uploading files...
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Buttons -->
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-lg"
                                        @onclick="Cancel"
                                        disabled="@isSubmitting">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </button>
                                <button type="submit"
                                        class="btn btn-warning btn-lg"
                                        disabled="@(isSubmitting || isUploading)">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Updating...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-save"></i>
                                        <span>Update Product</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Products product;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isUploading = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private string image1Preview = string.Empty;
    private string image2Preview = string.Empty;

    private const long MaxFileSize = 10 * 1024 * 1024; // 10 MB

    protected override async Task OnInitializedAsync()
    {
        await LoadProduct();
    }

    private async Task LoadProduct()
    {
        isLoading = true;
        product = await ProductService.GetByIdAsync(Id);
        isLoading = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e, int imageNumber)
    {
        isUploading = true;
        errorMessage = string.Empty;

        try
        {
            var file = e.File;

            if (file.Size > MaxFileSize)
            {
                errorMessage = $"File size exceeds 10 MB limit. Selected file: {file.Size / 1024 / 1024:F2} MB";
                return;
            }

            var uploadsPath = Path.Combine(Environment.WebRootPath, "uploads", "images");
            Directory.CreateDirectory(uploadsPath);

            var fileName = $"{Guid.NewGuid()}_{file.Name}";
            var filePath = Path.Combine(uploadsPath, fileName);

            await using FileStream fs = new(filePath, FileMode.Create);
            await file.OpenReadStream(MaxFileSize).CopyToAsync(fs);

            var relativePath = $"uploads/images/{fileName}";

            if (imageNumber == 1)
            {
                product.Image1 = relativePath;
                image1Preview = $"/{relativePath}";
            }
            else if (imageNumber == 2)
            {
                product.Image2 = relativePath;
                image2Preview = $"/{relativePath}";
            }

            successMessage = $"Image {imageNumber} uploaded successfully!";
            await Task.Delay(2000);
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading file: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task HandleVideoSelected(InputFileChangeEventArgs e)
    {
        isUploading = true;
        errorMessage = string.Empty;

        try
        {
            var file = e.File;

            if (file.Size > MaxFileSize * 5)
            {
                errorMessage = $"Video size exceeds 50 MB limit. Selected file: {file.Size / 1024 / 1024:F2} MB";
                return;
            }

            var uploadsPath = Path.Combine(Environment.WebRootPath, "uploads", "videos");
            Directory.CreateDirectory(uploadsPath);

            var fileName = $"{Guid.NewGuid()}_{file.Name}";
            var filePath = Path.Combine(uploadsPath, fileName);

            await using FileStream fs = new(filePath, FileMode.Create);
            await file.OpenReadStream(MaxFileSize * 5).CopyToAsync(fs);

            product.Video = $"uploads/videos/{fileName}";

            successMessage = "Video uploaded successfully!";
            await Task.Delay(2000);
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading video: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private void ClearFile(int fileNumber)
    {
        switch (fileNumber)
        {
            case 1:
                image1Preview = string.Empty;
                break;
            case 2:
                image2Preview = string.Empty;
                break;
            case 3:
                product.Video = string.Empty;
                break;
        }
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            bool success = await ProductService.UpdateAsync(product);

            if (success)
            {
                successMessage = $"Product '{product.Name}' has been successfully updated!";
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/products");
            }
            else
            {
                errorMessage = "Failed to update product. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/products");
    }
}