@page "/products2"
@rendermode InteractiveServer

@using Media.Services
@inject Products2Service Products2Service
@inject NavigationManager NavigationManager

<PageTitle>Products2</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-boxes"></i> Products2 (Many Media)</h2>
        <button class="btn btn-primary btn-lg" @onclick="AddNewProduct">
            <i class="bi bi-plus-circle"></i> Add Product2
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Loading products...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (items.Count == 0)
    {
        <div class="alert alert-info">No products found.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in items)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div style="height: 220px; overflow: hidden; background: #f8f9fa;" class="d-flex align-items-center justify-content-center">
                            @if (!string.IsNullOrWhiteSpace(item.PrimaryMediaUrl) && !IsVideo(item.PrimaryMediaUrl))
                            {
                                <img src="/@item.PrimaryMediaUrl" alt="@item.Product.Name" style="width:100%; height:100%; object-fit:cover;" />
                            }
                            else if (!string.IsNullOrWhiteSpace(item.PrimaryMediaUrl) && IsVideo(item.PrimaryMediaUrl))
                            {
                                <div class="text-center text-muted">
                                    <i class="bi bi-camera-video" style="font-size: 3rem;"></i>
                                    <div class="small mt-2">Primary media is video</div>
                                </div>
                            }
                            else
                            {
                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            }
                        </div>

                        <div class="card-body">
                            <h5 class="card-title">@item.Product.Name</h5>
                            <p class="card-text text-muted">
                                @if (!string.IsNullOrWhiteSpace(item.Product.Info))
                                {
                                    @(item.Product.Info.Length > 90 ? item.Product.Info[..90] + "..." : item.Product.Info)
                                }
                                else
                                {
                                    <em>No description</em>
                                }
                            </p>
                            <div class="d-flex gap-2">
                                <span class="badge bg-success">Media: @item.MediaCount</span>
                                <span class="badge bg-danger">Videos: @item.VideoCount</span>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent">
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-info flex-fill" @onclick="() => ViewProduct(item.Product.ID)">View</button>
                                <button class="btn btn-sm btn-outline-warning flex-fill" @onclick="() => EditProduct(item.Product.ID)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(item.Product.ID)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Delete this product and all of its media relations?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<Products2Service.Product2ListItem> items = new();
    private bool isLoading = true;
    private bool showDeleteModal;
    private int deleteId;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
    }

    private async Task LoadItems()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            items.Clear();
            items.AddRange(await Products2Service.GetListItemsAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddNewProduct() => NavigationManager.NavigateTo("/products2/add");
    private void ViewProduct(int id) => NavigationManager.NavigateTo($"/products2/view/{id}");
    private void EditProduct(int id) => NavigationManager.NavigateTo($"/products2/edit/{id}");

    private void AskDelete(int id)
    {
        deleteId = id;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        deleteId = 0;
    }

    private async Task ConfirmDelete()
    {
        await Products2Service.DeleteAsync(deleteId);
        showDeleteModal = false;
        deleteId = 0;
        await LoadItems();
    }

    private static bool IsVideo(string mediaUrl)
    {
        string ext = Path.GetExtension(mediaUrl).ToLowerInvariant();
        return ext is ".mp4" or ".avi" or ".mov" or ".wmv" or ".mkv" or ".webm";
    }
}
